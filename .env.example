APP_URL="https://erp.maingypsum.shop"
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB"
AUTH_SECRET=""
APP_ENV="staging"
STORAGE_DIR="./storage/private"
CRON_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Opsional: teruskan pesan Telegram ke Hermes AI Agent (bila kosong, ekstraksi lokal dipakai)
HERMES_WEBHOOK_URL=""
HERMES_WEBHOOK_TOKEN=""
# Password awal akun seed (ganti segera setelah login pertama)
SEED_PASSWORD=""
# Opsional: AI advisor di menu Analitik (kosong = hanya saran otomatis tanpa AI)
ANTHROPIC_API_KEY=""
# Atau provider OpenAI-compatible (dipakai bila diisi):
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Model cadangan bila AI_MODEL sedang habis kuota/tidak tersedia (pisahkan dengan koma)
AI_MODEL_FALLBACK=""
# Backup ke luar VPS (scripts/backup.sh). Kunci enkripsi WAJIB diisi & dicatat di tempat aman (tanpa kunci, backup tidak bisa dibuka)
BACKUP_PASSPHRASE=""
# Kirim backup terenkripsi ke chat Telegram ini lewat bot ERP (isi ID Telegram owner)
BACKUP_TELEGRAM_CHAT_ID=""
# Opsional: salin juga ke rclone remote, mis. "gdrive:MainGypsumBackup"
BACKUP_RCLONE_REMOTE=""

# Bot Telegram: JPG laporan dibuat Chromium headless (npx playwright-core install chromium).
# Opsional: CHROMIUM_PATH ke Chrome/Chromium yang sudah terpasang; INTERNAL_URL bila aplikasi tidak bisa diakses di http://127.0.0.1:$PORT
CHROMIUM_PATH=""
INTERNAL_URL=""

# Lupa password lewat email (Gmail + App Password). Kosong = tombol "Lupa password?" menampilkan "Hubungi Owner".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Main Gypsum ERP <alamat-gmail-anda@gmail.com>"

# Login dengan Google (OAuth Client "Web application" di Google Cloud Console). Kosong = tombol disembunyikan.
# Redirect URI yang didaftarkan: <APP_URL>/api/auth/google/callback (production & staging)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
