generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ORGANISASI & AKSES ============

enum Role {
  OWNER
  FINANCE
  ADMIN
  ADMIN_PRODUKSI
  ADMIN_MARKETPLACE
  KAPTEN_DIVISI
  SUPERVISOR
  PIC_CONTENT
  OPERATOR
  KOORDINATOR
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Asia/Jakarta")
  currency  String   @default("IDR")
  createdAt DateTime @default(now())
  stores    Store[]
}

model Store {
  id             String               @id @default(cuid())
  code           String               @unique
  name           String
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  active         Boolean              @default(true)
  products       Product[]
  journals       Journal[]
  transactions   FinanceTransaction[]
  sales          Sale[]
}

model Division {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  active         Boolean            @default(true)
  /// Format laporan penutup shift: PRODUKSI | GIFTBOX | PACKING | ASSEMBLING (null = laporan umum)
  reportTemplate String?
  /// Target hasil per shift (laporan shift menampilkan capaian %); kosong = tanpa target
  targetPerShift Int?
  /// Jumlah shift yang berlaku (1 = hanya Shift 1; Cetak & Oven/Produksi = 2)
  shiftCount     Int                @default(1)
  /// Checklist penutupan shift divisi: [{label, photo}] (photo = wajib foto bukti)
  checklist      Json               @default("[]")
  items          Item[]
  employees      Employee[]
  locations      Location[]
  production     ProductionEntry[]
  targets        ProductionTarget[]
  reports        ShiftReport[]
  stockReqs      StockRequest[]
  captains       User[]             @relation("DivisionCaptain")
}

model Shift {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  startTime        String // "07:00"
  endTime          String // "15:00"
  toleranceMinutes Int               @default(10)
  active           Boolean           @default(true)
  attendances      Attendance[]
  schedules        ShiftSchedule[]
  production       ProductionEntry[]
  reports          ShiftReport[]
}

model User {
  id             String               @id @default(cuid())
  username       String               @unique
  name           String
  /// Email opsional (unik, huruf kecil): untuk lupa password & login dengan Google
  email          String?              @unique
  passwordHash   String
  role           Role
  active         Boolean              @default(true)
  employeeId     String?              @unique
  employee       Employee?            @relation(fields: [employeeId], references: [id])
  divisionId     String?
  division       Division?            @relation("DivisionCaptain", fields: [divisionId], references: [id])
  failedLogins   Int                  @default(0)
  lockedUntil    DateTime?
  /// Naik setiap password diganti/direset; JWT dengan versi lama ditolak (sesi lama dicabut)
  sessionVersion Int                  @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime             @default(now())
  telegram       TelegramIdentity[]
  alertReads     AlertRead[]
  boronganPerson BoronganPerson?
  resetTokens    PasswordResetToken[]
}

/// Token reset password (lupa password). Hanya hash SHA-256 yang disimpan; sekali pakai, berlaku 30 menit.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Catatan permintaan lupa password (untuk batas per IP & per akun, termasuk akun yang tidak ada).
model PasswordResetRequest {
  id         String   @id @default(cuid())
  ip         String
  identifier String
  createdAt  DateTime @default(now())

  @@index([ip, createdAt])
  @@index([identifier, createdAt])
  @@index([createdAt])
}

/// Catatan percobaan login (untuk batas per IP & kunci bertahap). Dibersihkan otomatis setelah 2 hari.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  username  String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([username, ip, createdAt])
  @@index([createdAt])
}

model RolePermission {
  id         String  @id @default(cuid())
  role       Role
  permission String
  allowed    Boolean

  @@unique([role, permission])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Append-only: dilindungi trigger database (lihat migrasi audit_append_only)
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?

  @@index([entity, entityId])
  @@index([at])
}

// ============ KARYAWAN, ABSENSI, GAJI ============

enum EmployeeStatus {
  AKTIF
  CUTI
  NONAKTIF
}

enum WageType {
  HARIAN
  BORONGAN
  CAMPURAN
  BULANAN
}

model Employee {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  divisionId     String
  division       Division            @relation(fields: [divisionId], references: [id])
  /// Jabatan (tidak ditampilkan lagi sejak Nov 2026; cukup divisi + role)
  position       String              @default("")
  status         EmployeeStatus      @default(AKTIF)
  wageType       WageType            @default(HARIAN)
  dailyRate      BigInt              @default(0)
  /// Gaji pokok per siklus bulanan (jenis upah BULANAN)
  monthlySalary  BigInt              @default(0)
  phone          String?
  joinDate       DateTime?
  /// Tanggal resign; resign sebelum tanggal gajian = slip siklus itu Rp0
  resignDate     DateTime?           @db.Date
  /// BPJS Ketenagakerjaan dibayar perusahaan (info di slip, tidak memotong gaji); nominal kosong = bawaan setting bpjs_tk_amount
  bpjsTk         Boolean             @default(false)
  bpjsTkAmount   BigInt?
  user           User?
  attendances    Attendance[]
  schedules      ShiftSchedule[]
  production     ProductionEntry[]
  targets        ProductionTarget[]
  payslips       Payslip[]
  transportTrips TransportTrip[]
  pieceWorks     PieceWork[]
  advances       CashAdvance[]
  allowances     EmployeeAllowance[]
}

model ShiftSchedule {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  date       DateTime @db.Date

  @@unique([employeeId, date])
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  ALPA
  LIBUR
}

model Attendance {
  id               String           @id @default(cuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id])
  shiftId          String
  shift            Shift            @relation(fields: [shiftId], references: [id])
  date             DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  status           AttendanceStatus
  lateMinutes      Int              @default(0)
  note             String?
  validated        Boolean          @default(false)
  validatedBy      String?
  validatedAt      DateTime?
  /// Koordinat GPS saat absen masuk/pulang (diisi dari HP karyawan)
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  /// Jarak ke titik lokasi kerja terdekat (meter)
  checkInDistance  Int?
  checkInSiteId    String?
  checkInSite      WorkSite?        @relation("CheckInSite", fields: [checkInSiteId], references: [id], onDelete: SetNull)
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutDistance Int?
  /// Absen pulang saat laporan shift divisinya belum terkirim (hanya peringatan, tanda untuk Owner)
  reportMissing    Boolean          @default(false)

  @@unique([employeeId, date])
}

/// Titik lokasi kerja untuk absen (geofence). Absen hanya bisa di dalam radius salah satu titik aktif.
model WorkSite {
  id        String       @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  radiusM   Int          @default(100)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  checkIns  Attendance[] @relation("CheckInSite")
}

/// Tarif borongan per tahap (Filling Cat, Assembling, dll.)
model PieceRate {
  id         String          @id @default(cuid())
  stage      ProductionStage @unique
  ratePerPcs BigInt
}

model TransportTrip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @db.Date
  amount     BigInt
  note       String?
}

/// PERIODE = periode manual (harian/campuran), BULANAN = siklus H+7 otomatis, BORONGAN = klaim pekerja borongan
enum PayrollKind {
  PERIODE
  BULANAN
  BORONGAN
  TUNJANGAN
}

/// Kasbon karyawan: dipotong dari gaji berikutnya (cicilan per slip, 0 = langsung lunas)
model CashAdvance {
  id                String    @id @default(cuid())
  number            String    @unique
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  date              DateTime  @db.Date
  amount            BigInt
  installment       BigInt    @default(0)
  repaid            BigInt    @default(0)
  paidFromAccountId String
  note              String?
  journalId         String?
  createdBy         String
  createdAt         DateTime  @default(now())
  /// Dibatalkan: jurnal dibalik, dokumen tetap tersimpan
  cancelledAt       DateTime?
  cancelReason      String?

  @@index([employeeId])
}

/// Jenis tugas borongan (dibayar per piece), tarif bisa diubah.
/// ratePerPcs = budget total per pcs, dibagi ke pekerja, koordinator, dan driver.
model PieceTask {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  ratePerPcs      BigInt
  workerRate      BigInt           @default(0)
  coordinatorRate BigInt           @default(0)
  driverRate      BigInt           @default(0)
  /// Barang hasil kerja (mis. Giftbox Sudah Dicat) yang bertambah di stok titik
  outputItemId    String?
  outputItem      Item?            @relation(fields: [outputItemId], references: [id])
  active          Boolean          @default(true)
  works           PieceWork[]
  inputs          PieceTaskInput[]
  results         BoronganResult[]
  recipeLabor     RecipeLabor[]
}

/// Bahan yang terpakai per 1 pcs hasil tugas borongan (satuan resep/HPP bila ada, seperti BOM)
model PieceTaskInput {
  id     String    @id @default(cuid())
  taskId String
  task   PieceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  itemId String
  item   Item      @relation(fields: [itemId], references: [id])
  qty    Decimal   @db.Decimal(14, 4)
}

// ============ BORONGAN TETANGGA ============

enum BoronganRole {
  PEKERJA
  KOORDINATOR
  DRIVER
}

enum HandoverKind {
  KIRIM
  KEMBALI
}

enum HandoverStatus {
  DIKIRIM
  DITERIMA
  DIBATALKAN
}

/// Titik kerja borongan (BMR, Mastrip); stok bahan & hasil di titik memakai lokasi stok sendiri
model BoronganPoint {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  locationId  String               @unique
  location    Location             @relation(fields: [locationId], references: [id])
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  people      BoronganPerson[]
  handovers   BoronganHandover[]
  results     BoronganResult[]
  settlements BoronganSettlement[]
}

/// Tetangga yang bekerja borongan (bukan karyawan): pekerja & koordinator per titik, driver tanpa titik
model BoronganPerson {
  id            String             @id @default(cuid())
  name          String
  phone         String?
  role          BoronganRole
  pointId       String?
  point         BoronganPoint?     @relation(fields: [pointId], references: [id])
  /// Akun login koordinator (role KOORDINATOR)
  userId        String?            @unique
  user          User?              @relation(fields: [userId], references: [id])
  active        Boolean            @default(true)
  note          String?
  createdAt     DateTime           @default(now())
  works         BoronganResult[]   @relation("ResultWorker")
  coordinated   BoronganResult[]   @relation("ResultCoordinator")
  drivenResults BoronganResult[]   @relation("ResultDriver")
  drives        BoronganHandover[]
}

/// Serah terima lewat driver: KIRIM = bahan gudang → titik, KEMBALI = hasil titik → gudang.
/// Saat dibuat barang pindah ke lokasi driver; saat dikonfirmasi diterima pindah ke tujuan.
model BoronganHandover {
  id         String                 @id @default(cuid())
  number     String                 @unique
  kind       HandoverKind
  status     HandoverStatus         @default(DIKIRIM)
  pointId    String
  point      BoronganPoint          @relation(fields: [pointId], references: [id])
  driverId   String?
  driver     BoronganPerson?        @relation(fields: [driverId], references: [id])
  date       DateTime
  receivedAt DateTime?
  receivedBy String?
  note       String?
  createdBy  String
  createdAt  DateTime               @default(now())
  lines      BoronganHandoverLine[]

  @@index([pointId, status])
}

model BoronganHandoverLine {
  id          String           @id @default(cuid())
  handoverId  String
  handover    BoronganHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item             @relation(fields: [itemId], references: [id])
  /// Lokasi gudang asal (KIRIM) atau tujuan (KEMBALI)
  warehouseId String
  qty         Decimal          @db.Decimal(14, 3)
}

/// Setoran hasil kerja per pekerja; upah dibagi pekerja/koordinator/driver sesuai tarif saat dicatat
model BoronganResult {
  id              String              @id @default(cuid())
  number          String              @unique
  pointId         String
  point           BoronganPoint       @relation(fields: [pointId], references: [id])
  workerId        String
  worker          BoronganPerson      @relation("ResultWorker", fields: [workerId], references: [id])
  coordinatorId   String?
  coordinator     BoronganPerson?     @relation("ResultCoordinator", fields: [coordinatorId], references: [id])
  driverId        String?
  driver          BoronganPerson?     @relation("ResultDriver", fields: [driverId], references: [id])
  taskId          String
  task            PieceTask           @relation(fields: [taskId], references: [id])
  date            DateTime            @db.Date
  qty             Int
  workerRate      BigInt
  coordinatorRate BigInt
  driverRate      BigInt
  note            String?
  settlementId    String?
  settlement      BoronganSettlement? @relation(fields: [settlementId], references: [id])
  createdBy       String
  createdAt       DateTime            @default(now())

  @@index([pointId, settlementId])
}

/// Pembayaran upah borongan satu titik (pekerja + koordinator + driver), dibayar bersamaan
model BoronganSettlement {
  id            String           @id @default(cuid())
  number        String           @unique
  pointId       String
  point         BoronganPoint    @relation(fields: [pointId], references: [id])
  date          DateTime
  upTo          DateTime         @db.Date
  bankAccountId String
  total         BigInt
  journalId     String?
  createdBy     String
  createdAt     DateTime         @default(now())
  results       BoronganResult[]
  /// Dibatalkan: jurnal dibalik, dokumen tetap tersimpan
  cancelledAt   DateTime?
  cancelReason  String?
}

/// Hasil kerja borongan per pekerja; periodId terisi setelah diklaim
model PieceWork {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  taskId     String
  task       PieceTask      @relation(fields: [taskId], references: [id])
  date       DateTime       @db.Date
  qty        Int
  rate       BigInt
  amount     BigInt
  note       String?
  periodId   String?
  period     PayrollPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdBy  String
  createdAt  DateTime       @default(now())

  @@index([employeeId, periodId])
}

enum PayrollStatus {
  DRAFT
  DISETUJUI
  DIBAYAR
}

model PayrollPeriod {
  id                String        @id @default(cuid())
  code              String        @unique
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  status            PayrollStatus @default(DRAFT)
  kind              PayrollKind   @default(PERIODE)
  /// Tanggal gajian (siklus bulanan: H+7)
  payDate           DateTime?     @db.Date
  /// Klaim borongan: pekerja yang mengklaim
  employeeId        String?
  approvedBy        String?
  paidAt            DateTime?
  paidFromAccountId String?
  journalId         String?
  createdAt         DateTime      @default(now())
  payslips          Payslip[]
  pieceWorks        PieceWork[]
}

model Payslip {
  id               String        @id @default(cuid())
  periodId         String
  period           PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id])
  daysPresent      Int
  /// Gaji bulanan: gaji pokok, hari tidak masuk dalam jatah libur, dan hari bolos
  baseSalary       BigInt        @default(0)
  offDays          Int           @default(0)
  absentDays       Int           @default(0)
  note             String?
  dailyWage        BigInt
  pieceWage        BigInt
  pieceDetail      Json
  transport        BigInt
  bonus            BigInt        @default(0)
  deduction        BigInt        @default(0)
  /// Potongan kasbon pada slip ini; rincian [{id, number, amount}]
  advanceDeduction BigInt        @default(0)
  advanceDetail    Json          @default("[]")
  /// Tunjangan (periode TUNJANGAN, dibayar tiap tanggal 15); rincian [{name, amount}]
  allowance        BigInt        @default(0)
  allowanceDetail  Json          @default("[]")
  /// Rekap telat periode ini (hanya rekap, tidak memotong gaji): berapa kali & total menit di atas toleransi
  lateCount        Int           @default(0)
  lateMinutes      Int           @default(0)
  /// BPJS Ketenagakerjaan per bulan yang ditanggung perusahaan (info saja, tidak masuk total)
  bpjsCompany      BigInt        @default(0)
  total            BigInt

  @@unique([periodId, employeeId])
}

// ============ PRODUKSI ============

enum ProductionStage {
  CETAK
  PANEN_1
  SORTIR_1
  OVEN
  PANEN_2
  SORTIR_2
  FILLING_CAT
  ASSEMBLING
  QC
  PACKING
  BARANG_JADI
}

model ProductionEntry {
  id           String          @id @default(cuid())
  date         DateTime        @db.Date
  shiftId      String
  shift        Shift           @relation(fields: [shiftId], references: [id])
  divisionId   String
  division     Division        @relation(fields: [divisionId], references: [id])
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id])
  stage        ProductionStage
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  qtyGood      Int
  qtyReject    Int             @default(0)
  /// Penyebab reject (lihat REJECT_REASONS); wajib bila qtyReject > 0
  rejectReason String?
  note         String?
  createdBy    String
  createdAt    DateTime        @default(now())
  stockPosted  Boolean         @default(false)

  @@index([date, shiftId, divisionId])
}

model ProductionTarget {
  id         String          @id @default(cuid())
  divisionId String
  division   Division        @relation(fields: [divisionId], references: [id])
  employeeId String?
  employee   Employee?       @relation(fields: [employeeId], references: [id])
  stage      ProductionStage
  dailyQty   Int
  active     Boolean         @default(true)
}

enum ReportStatus {
  DRAFT
  TERKIRIM
  DIREVISI
}

model ShiftReport {
  id                String         @id @default(cuid())
  date              DateTime       @db.Date
  shiftId           String
  shift             Shift          @relation(fields: [shiftId], references: [id])
  divisionId        String
  division          Division       @relation(fields: [divisionId], references: [id])
  status            ReportStatus   @default(DRAFT)
  /// [{label, photo, done, photoPath?}]
  checklist         Json           @default("[]")
  /// PIC divisi yang melaporkan shift ini
  picName           String?
  /// Detail hasil kerja sesuai format divisi (lihat src/lib/shiftReport.ts)
  work              Json           @default("{}")
  /// Stok akhir shift (hitung fisik): [{itemId, name, unit, limit, qty}]
  stockCount        Json           @default("[]")
  /// Hitungan stok sudah diterapkan ke kartu stok (penyesuaian stock opname)
  stockApplied      Boolean        @default(false)
  /// Hitungan stok yang terakhir diterapkan; revisi laporan hanya menerapkan selisihnya
  stockAppliedCount Json?
  /// Versi posting hasil kerja ke stok setengah jadi / barang jadi (0 = belum); revisi = balik versi lama lalu posting versi baru
  workPostedVersion Int            @default(0)
  /// Stok akhir hasil (patung kering / produk jadi per karakter) yang terakhir diterapkan ke stok: [{itemId, qty}]
  resultApplied     Json?
  receipts          ShiftReceipt[]
  complaints        String?
  followUp          String?
  followUpStatus    String         @default("BELUM")
  createdBy         String
  createdAt         DateTime       @default(now())
  sends             ReportSend[]

  @@unique([date, shiftId, divisionId])
}

/// Barang masuk dari supplier/toko yang dilaporkan divisi di laporan shift (sebelum stok akhir dihitung).
/// Belum ditautkan = sudah ada fisik di gudang tapi belum dicatat di Pembelian: stock opname menganggapnya sudah ada
/// (tidak jadi pemakaian/HPP). Saat ditautkan ke Pembelian, stok masuk bertanggal waktu barang masuk (tidak dobel).
model ShiftReceipt {
  id           String      @id @default(cuid())
  number       String      @unique
  reportId     String
  report       ShiftReport @relation(fields: [reportId], references: [id])
  divisionId   String
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id])
  qty          Decimal     @db.Decimal(14, 3)
  /// Nama supplier/toko yang tertulis di nota (bebas)
  supplierName String?
  photoPath    String?
  photoMime    String?
  /// Waktu barang dicatat masuk (tidak melewati jam selesai shift laporan)
  receivedAt   DateTime
  purchaseId   String?
  purchase     Purchase?   @relation(fields: [purchaseId], references: [id])
  createdBy    String
  createdAt    DateTime    @default(now())

  @@index([itemId, purchaseId])
}

model ReportSend {
  id       String      @id @default(cuid())
  reportId String
  report   ShiftReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sentAt   DateTime    @default(now())
  sentBy   String
  channel  String
  status   String
  error    String?
}

// ============ STOK ============

/// Cara beli bahan: OFFLINE (toko/supplier langsung) atau ONLINE (lewat link produk)
enum BuyMode {
  OFFLINE
  ONLINE
}

enum ItemType {
  BAHAN_BAKU
  BARANG_DALAM_PROSES
  BARANG_JADI
}

model Supplier {
  id        String     @id @default(cuid())
  /// Kode otomatis SUP-001
  code      String?    @unique
  name      String
  phone     String?
  address   String?
  note      String?
  active    Boolean    @default(true)
  /// Nama lain (dipisah koma), mis. nama lama setelah digabung: dikenali saat input hutang/pembelian & di bot
  aliases   String     @default("")
  items     Item[]
  payables  Payable[]
  purchases Purchase[]
}

/// Pelanggan offline (pembeli langsung, bukan lewat marketplace)
model Customer {
  id        String   @id @default(cuid())
  /// Kode otomatis PLG-001
  code      String?  @unique
  name      String
  phone     String?
  address   String?
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model GypsumCharacter {
  id             String  @id @default(cuid())
  name           String
  waterRatio     String?
  settingMinutes Int?
  hardness       String?
  note           String?
  items          Item[]
}

model Location {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  divisionId    String?
  division      Division?       @relation(fields: [divisionId], references: [id])
  movesFrom     StockMovement[] @relation("MoveFrom")
  movesTo       StockMovement[] @relation("MoveTo")
  boronganPoint BoronganPoint?
}

model Item {
  id                String                 @id @default(cuid())
  sku               String                 @unique
  name              String
  type              ItemType
  unit              String
  minStock          Decimal                @default(0) @db.Decimal(14, 3)
  avgCost           BigInt                 @default(0)
  /// Satuan resep/HPP (mis. gram) bila berbeda dari satuan stok `unit` (mis. sak); BOM memakai satuan ini
  hppUnit           String?
  /// Jumlah hppUnit dalam 1 unit stok (1 sak gypsum = 18000 gram)
  hppFactor         Decimal                @default(1) @db.Decimal(14, 4)
  /// Harga beli terbaru & sebelumnya per unit stok, untuk HPP realtime dan indikator naik/turun
  lastCost          BigInt                 @default(0)
  prevCost          BigInt                 @default(0)
  lastCostAt        DateTime?
  /// Harga pembelian terakhir (total Rp) & jumlahnya (satuan beli): lastCost = buyPrice ÷ buyQty
  buyPrice          BigInt                 @default(0)
  buyQty            Decimal                @default(1) @db.Decimal(14, 3)
  /// Harga diisi manual oleh Owner (bukan dari pembelian): siapa & kapan
  costManualBy      String?
  costManualAt      DateTime?
  /// OFFLINE / ONLINE; bila ONLINE, productUrl = link produk untuk order
  buyMode           BuyMode                @default(OFFLINE)
  productUrl        String?
  /// Jumlah order biasa (satuan beli) untuk permintaan stok otomatis
  orderQty          Decimal                @default(0) @db.Decimal(14, 3)
  supplierId        String?
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  gypsumCharacterId String?
  gypsumCharacter   GypsumCharacter?       @relation(fields: [gypsumCharacterId], references: [id])
  active            Boolean                @default(true)
  /// Divisi penanggung jawab stock opname bahan baku ini; minStock = limit order
  divisionId        String?
  division          Division?              @relation(fields: [divisionId], references: [id])
  sortOrder         Int                    @default(0)
  /// Klasifikasi item (mis. Bahan Utama); menentukan awalan kode otomatis
  category          String?
  note              String?
  movements         StockMovement[]
  bomLines          BomLine[]
  requests          StockRequest[]
  product           Product?               @relation("ProductFinishedItem")
  purchaseLines     PurchaseLine[]
  /// Resep barang setengah jadi: komponen, tenaga kerja & overhead per 1 unit stok
  recipe            ItemRecipeLine[]       @relation("RecipeOf")
  usedInRecipes     ItemRecipeLine[]       @relation("RecipeComponent")
  pieceInputs       PieceTaskInput[]
  pieceOutputs      PieceTask[]
  handoverLines     BoronganHandoverLine[]
  recipeLabor       RecipeLabor[]
  recipeOverhead    RecipeOverhead[]
  saleLines         SaleLine[]
  shiftReceipts     ShiftReceipt[]
}

enum MovementType {
  PENERIMAAN
  PENGELUARAN
  TRANSFER
  PENYESUAIAN
  KONSUMSI_PRODUKSI
  HASIL_PRODUKSI
}

model StockMovement {
  id             String       @id @default(cuid())
  date           DateTime     @default(now())
  type           MovementType
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  fromLocationId String?
  fromLocation   Location?    @relation("MoveFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?    @relation("MoveTo", fields: [toLocationId], references: [id])
  qty            Decimal      @db.Decimal(14, 3)
  unitCost       BigInt       @default(0)
  ref            String?
  note           String?
  createdBy      String
  journalId      String?

  @@index([itemId, date])
  @@index([ref])
  @@index([date])
}

enum RequestStatus {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DIPENUHI
}

model StockRequest {
  id          String        @id @default(cuid())
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  divisionId  String
  division    Division      @relation(fields: [divisionId], references: [id])
  qty         Decimal       @db.Decimal(14, 3)
  note        String?
  status      RequestStatus @default(DIAJUKAN)
  requestedBy String
  decidedBy   String?
  /// Dibuat otomatis dari laporan shift (stok ≤ limit)
  auto        Boolean       @default(false)
  reportId    String?
  createdAt   DateTime      @default(now())

  @@index([itemId, status])
}

// ============ PRODUK & HPP ============

/// Tipe produk jadi (diatur Owner di Pengaturan › Tipe produk). Kode bawaan: SATUAN, PAKET_12, PAKET_24, PAKET_48, GIFTBOX, CUSTOM
model ProductTypeOption {
  code      String  @id
  name      String
  /// Isi per paket bawaan (mis. Paket 12 = 12)
  packQty   Int     @default(1)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

enum ProductVariant {
  COWOK
  CEWEK
  HEWAN
  TRANSPORTASI
  MIX
}

model Product {
  id             String                @id @default(cuid())
  sku            String                @unique
  name           String
  /// Kode ProductTypeOption (dulu enum ProductType)
  type           String
  variant        ProductVariant
  storeId        String
  store          Store                 @relation(fields: [storeId], references: [id])
  packQty        Int                   @default(1)
  laborCost      BigInt                @default(0)
  overheadCost   BigInt                @default(0)
  /// Target margin (% dari harga jual), affiliate & iklan (% harga) untuk saran harga
  targetMargin   Decimal               @default(30) @db.Decimal(5, 2)
  affiliatePct   Decimal               @default(0) @db.Decimal(5, 2)
  adsPct         Decimal               @default(0) @db.Decimal(5, 2)
  /// Rata-rata jumlah produk per pesanan marketplace (biaya pesanan flat dibagi ke tiap produk)
  itemsPerOrder  Decimal               @default(1) @db.Decimal(6, 2)
  /// Tambahan biaya kemasan lain per produk (opsional)
  extraPackaging BigInt                @default(0)
  category       String?
  note           String?
  recipeLabor    RecipeLabor[]
  recipeOverhead RecipeOverhead[]
  active         Boolean               @default(true)
  finishedItemId String?               @unique
  finishedItem   Item?                 @relation("ProductFinishedItem", fields: [finishedItemId], references: [id])
  bom            BomLine[]
  prices         PriceHistory[]
  production     ProductionEntry[]
  /// Produk induk (katalog varian), mis. Giftbox; null = produk lepas
  familyId       String?
  family         ProductFamily?        @relation(fields: [familyId], references: [id])
  /// Pilihan varian SKU ini (satu per kategori varian induk)
  variantValues  ProductVariantValue[]

  @@index([familyId])
}

/// Produk induk: satu nama produk dengan beberapa kategori varian (mis. Giftbox: Tipe × Paket × Series); tiap kombinasi = satu Product (SKU)
model ProductFamily {
  id        String        @id @default(cuid())
  /// Kode otomatis IND-001
  code      String        @unique
  name      String
  /// Kode ProductTypeOption bawaan SKU (bisa ditimpa pilihan varian, mis. Jumlah 12 → PAKET_12)
  type      String
  /// Jumlah patung per SKU bila tidak ditentukan pilihan varian (Giftbox = 5)
  patungQty Int           @default(1)
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  note      String?
  axes      VariantAxis[]
  products  Product[]
}

/// Kategori varian produk induk (Tipe, Paket, Series, Jumlah)
model VariantAxis {
  id        String          @id @default(cuid())
  familyId  String
  family    ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int             @default(0)
  options   VariantOption[]

  @@unique([familyId, name])
}

/// Pilihan dalam kategori varian (mis. Series: Cowok)
model VariantOption {
  id          String                @id @default(cuid())
  axisId      String
  axis        VariantAxis           @relation(fields: [axisId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int                   @default(0)
  active      Boolean               @default(true)
  /// Jumlah patung per SKU yang memakai pilihan ini (mis. Jumlah 24 = 24)
  patungQty   Int?
  /// Karakter patung (Series) → varian produk & patung kering yang dipakai
  variant     ProductVariant?
  /// Tipe produk SKU yang memakai pilihan ini (mis. Jumlah 12 → PAKET_12)
  productType String?
  values      ProductVariantValue[]

  @@unique([axisId, name])
}

model ProductVariantValue {
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId  String
  option    VariantOption @relation(fields: [optionId], references: [id])

  @@id([productId, optionId])
  @@index([optionId])
}

/// Komponen resep barang setengah jadi (bahan baku atau setengah jadi lain), qty dalam satuan resep komponen
model ItemRecipeLine {
  id          String  @id @default(cuid())
  itemId      String
  item        Item    @relation("RecipeOf", fields: [itemId], references: [id], onDelete: Cascade)
  componentId String
  component   Item    @relation("RecipeComponent", fields: [componentId], references: [id])
  qty         Decimal @db.Decimal(14, 4)
  /// Satuan pakai yang dipilih di form (qty tetap disimpan dalam satuan resep komponen)
  useUnit     String?

  @@unique([itemId, componentId])
}

/// Biaya overhead bulanan (listrik, LPG, penyusutan, sewa, dll.) yang dibebankan per pcs produksi
model Overhead {
  id                String           @id @default(cuid())
  category          String
  name              String
  /// Biaya per bulan; untuk penyusutan = harga aset / umur (bulan)
  monthlyAmount     BigInt
  assetCost         BigInt?
  lifeMonths        Int?
  /// Estimasi output per bulan (pcs); beban per pcs = biaya per bulan / output
  outputPerMonth    Int              @default(0)
  note              String?
  usages            RecipeOverhead[]
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  /// Biaya per bulan dihitung otomatis dari gaji karyawan (gaji pokok + tunjangan + BPJS TK) divisi terpilih
  autoSalary        Boolean          @default(false)
  /// Divisi yang gajinya dijumlah (kosong = semua divisi berformat laporan shift)
  salaryDivisionIds String[]         @default([])
  /// Terakhir dihitung ulang otomatis
  autoUpdatedAt     DateTime?
  /// Output per bulan diambil otomatis dari laporan shift (total panen patung kering 30 hari terakhir); false = diisi manual
  outputAuto        Boolean          @default(false)
}

/// Tenaga kerja dalam resep (barang setengah jadi atau produk): dari tarif borongan atau tarif custom, per 1 unit
model RecipeLabor {
  id        String     @id @default(cuid())
  itemId    String?
  item      Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  taskId    String?
  task      PieceTask? @relation(fields: [taskId], references: [id])
  name      String
  rate      BigInt
}

/// Overhead dalam resep: beban per pcs overhead master × faktor
model RecipeOverhead {
  id         String   @id @default(cuid())
  itemId     String?
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  overheadId String
  overhead   Overhead @relation(fields: [overheadId], references: [id])
  factor     Decimal  @default(1) @db.Decimal(10, 4)
}

model BomLine {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id])
  qty       Decimal @db.Decimal(14, 4)
  useUnit   String?

  @@unique([productId, itemId])
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel     String
  price       BigInt
  hpp         BigInt
  effectiveAt DateTime @default(now())
  createdBy   String
}

// ============ FINANCE ============

model BankAccount {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  coaAccountId  String
  coaAccount    CoaAccount     @relation(fields: [coaAccountId], references: [id])
  aliases       String         @default("")
  active        Boolean        @default(true)
  /// Saldo penjual marketplace (Shopee/TikTok): withdraw dari rekening ini sekaligus dicatat sebagai pemasukan penjualan
  marketplace   Boolean        @default(false)
  salePayments  SalePayment[]
  balanceChecks BalanceCheck[]
}

enum BalanceCheckStatus {
  MENUNGGU
  SESUAI
  TIDAK_SESUAI
}

/// Konfirmasi saldo pagi: saldo buku per rekening (kemarin 23.59 WIB) dicek pengelola dengan aplikasi bank
model BalanceCheck {
  id             String             @id @default(cuid())
  /// Tanggal saldo yang dicek (kemarin, WIB)
  date           DateTime           @db.Date
  bankAccountId  String
  bankAccount    BankAccount        @relation(fields: [bankAccountId], references: [id])
  /// Saldo buku per tanggal tsb pukul 23.59 WIB
  bookBalance    BigInt
  /// Saldo buku saat pesan dikirim / saat saldo bank diketik
  currentBalance BigInt
  /// Saldo di aplikasi bank yang diketik pengecek (bila tidak sesuai)
  bankBalance    BigInt?
  /// bankBalance − currentBalance
  diff           BigInt?
  status         BalanceCheckStatus @default(MENUNGGU)
  /// Mutasi rekening: [{path, mime}] di penyimpanan privat
  attachments    Json               @default("[]")
  /// true = pengecek sudah menekan Selesai (lampiran lengkap)
  done           Boolean            @default(false)
  checkedById    String?
  checkedByName  String?
  checkedAt      DateTime?
  remindedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([date, bankAccountId])
  @@index([status])
}

enum TxDirection {
  MASUK
  KELUAR
  TRANSFER
}

model TxCategory {
  id           String      @id @default(cuid())
  name         String
  direction    TxDirection
  coaAccountId String
  coaAccount   CoaAccount  @relation(fields: [coaAccountId], references: [id])
  keywords     String      @default("")
  active       Boolean     @default(true)
}

enum TxStatus {
  DRAFT
  PERLU_DITINJAU
  MENUNGGU_KONFIRMASI
  /// Withdraw TikTok sudah dikonfirmasi tetapi uangnya belum masuk rekening bank (belum ada jurnal)
  DALAM_PROSES
  DIBUKUKAN
  DITOLAK
  DIBATALKAN
}

enum TxSource {
  MANUAL
  TELEGRAM
  AI
}

model FinanceTransaction {
  id                  String           @id @default(cuid())
  number              String           @unique
  source              TxSource
  direction           TxDirection
  amount              BigInt
  date                DateTime
  accountId           String?
  toAccountId         String?
  categoryId          String?
  suggestedCategoryId String?
  storeId             String?
  store               Store?           @relation(fields: [storeId], references: [id])
  counterparty        String?
  note                String?
  rawText             String?
  proofPath           String?
  proofMime           String?
  aiExtraction        Json?
  status              TxStatus         @default(DRAFT)
  fingerprint         String
  duplicateOfId       String?
  idempotencyKey      String?          @unique
  journalId           String?
  createdBy           String
  createdAt           DateTime         @default(now())
  /// Dihapus dari daftar (hanya status Dibatalkan/Ditolak); baris & jurnalnya tetap ada untuk jejak audit
  deletedAt           DateTime?
  deletedBy           String?
  telegramChatId      String?
  telegramMessageId   String?
  approvals           ApprovalLog[]
  /// Rincian: satu transfer untuk beberapa keperluan (kategori/bahan baku berbeda)
  splits              FinanceTxSplit[]
  /// Pembayaran hutang supplier / cicilan pinjaman: nominal = pokok + payInterest (bunga/biaya → beban bunga)
  payableId           String?
  payable             Payable?         @relation(fields: [payableId], references: [id])
  /// Kategori BPJS Ketenagakerjaan: karyawan yang dibayarkan iurannya (satu atau beberapa sekaligus)
  bpjsEmployeeIds     String[]         @default([])
  payInterest         BigInt           @default(0)
  /// Transfer dana sisihan: rincian sisihan {parts:[{fundId,date,amount}]} yang dibukukan bersama transaksi ini,
  /// atau {skip:true} = transfer biasa (tidak dicocokkan ke dana sisihan)
  reserveLink         Json?
  reserveEntries      ReserveEntry[]
  /// Pengembalian dana talangan: transfer dari rekening operasional ke dompet simpanan (Seabank 0006 / ShopeePay)
  bailoutRepay        Boolean          @default(false)
  /// Baris tertaut dari menu lain (PEMBELIAN, PAYROLL, KASBON, SISIHAN, ...): uang rekening yang dibukukan di menu
  /// sumbernya. Jurnalnya = jurnal sumber (journalId), tidak ada jurnal kedua. Kosong = transaksi milik menu Transaksi.
  origin              String?
  /// Nomor/id dokumen sumber (mis. nomor pembelian) untuk tautan ke menu asal
  originRef           String?
  /// Transaksi lain yang sudah dinyatakan "berbeda, bukan duplikat" (tidak ditanyakan lagi)
  dupAckIds           String[]         @default([])
  /// Withdraw TikTok: jam dikonfirmasi "Ditransfer ke bank" (masuk status Dalam Proses)
  sentAt              DateTime?
  /// Withdraw TikTok: jam uang diterima di rekening bank (= tanggal pembukuan)
  receivedAt          DateTime?
  /// Withdraw TikTok: screenshot bukti uang masuk (bank) / Seller Center "sudah ditransfer" (wajib saat Uang diterima)
  receivedProofPath   String?
  receivedProofMime   String?
  /// Hasil baca bukti {amounts, amount, date, time, manual}
  receivedProofRead   Json?
  /// Withdraw TikTok: No. Referensi di "Detail penarikan dana" Seller Center (sama = duplikat pasti)
  withdrawRef         String?

  @@index([fingerprint])
  @@index([withdrawRef])
  @@index([origin])
  @@index([status])
  @@index([deletedAt])
}

/// Rincian transaksi: jumlah semua baris = nominal transaksi. Baris dengan itemId = pembelian bahan baku (stok masuk)
model FinanceTxSplit {
  id            String             @id @default(cuid())
  transactionId String
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String?
  amount        BigInt
  note          String?
  itemId        String?
  qty           Decimal?           @db.Decimal(14, 3)
  sortOrder     Int                @default(0)

  @@index([transactionId])
}

model ApprovalLog {
  id            String             @id @default(cuid())
  transactionId String
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id])
  action        String
  fromStatus    TxStatus?
  toStatus      TxStatus
  actorUserId   String?
  actorName     String
  viaTelegramId String?
  note          String?
  at            DateTime           @default(now())
}

model TelegramIdentity {
  id             String  @id @default(cuid())
  telegramUserId String  @unique
  telegramName   String?
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  canSubmit      Boolean @default(true)
  canConfirm     Boolean @default(false)
  receiveRecap   Boolean @default(false)
  chatId         String?
  active         Boolean @default(true)
}

model ApiClient {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String    @unique
  keyHash    String
  scopes     String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model IdempotencyRecord {
  key       String   @id
  clientId  String
  status    Int
  response  Json
  createdAt DateTime @default(now())
}

/// Isian bertahap di bot Telegram (input produksi, mutasi stok, absen). Satu sesi aktif per chat, kedaluwarsa 30 menit.
/// Usulan kategori transaksi baru dari bot: dibuat hanya setelah Owner/Finance menyetujui
model CategoryProposal {
  id            String      @id @default(cuid())
  name          String
  direction     TxDirection
  /// Tipe akun COA baru (BEBAN/HPP/PENDAPATAN) dan akun induknya
  coaType       AccountType
  parentCoaId   String?
  keywords      String      @default("")
  /// Transaksi (draft) yang memicu usulan; diberi kategori ini saat disetujui
  transactionId String?
  chatId        String?
  proposedById  String
  proposedBy    String
  /// MENUNGGU / DISETUJUI / DITOLAK
  status        String      @default("MENUNGGU")
  decidedBy     String?
  decidedAt     DateTime?
  categoryId    String?
  createdAt     DateTime    @default(now())

  @@index([status])
}

model BotSession {
  chatId    String   @id
  userId    String
  flow      String
  step      String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  channel String
  type    String
  target  String?
  status  String
  payload String?
  error   String?
}

// ============ AKUNTANSI ============

enum AccountType {
  ASET
  KEWAJIBAN
  EKUITAS
  PENDAPATAN
  HPP
  BEBAN
}

model CoaAccount {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  type       AccountType
  isCash     Boolean         @default(false)
  parentId   String?
  parent     CoaAccount?     @relation("CoaTree", fields: [parentId], references: [id])
  children   CoaAccount[]    @relation("CoaTree")
  active     Boolean         @default(true)
  lines      JournalLine[]
  banks      BankAccount[]
  categories TxCategory[]
  payables   Payable[]
  budgets    ExpenseBudget[]
}

/// Anggaran beban per bulan per akun COA (tipe BEBAN/HPP). Realisasi dihitung dari jurnal.
model ExpenseBudget {
  id        String     @id @default(cuid())
  year      Int
  month     Int
  accountId String
  account   CoaAccount @relation(fields: [accountId], references: [id])
  amount    BigInt
  note      String?
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([year, month, accountId])
  @@index([year, month])
}

model Journal {
  id           String        @id @default(cuid())
  number       String        @unique
  date         DateTime
  description  String
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  source       String
  sourceId     String?
  createdBy    String
  createdAt    DateTime      @default(now())
  reversalOfId String?
  lines        JournalLine[]

  @@index([date])
  @@index([source, sourceId])
}

model JournalLine {
  id        String     @id @default(cuid())
  journalId String
  journal   Journal    @relation(fields: [journalId], references: [id])
  accountId String
  account   CoaAccount @relation(fields: [accountId], references: [id])
  debit     BigInt     @default(0)
  credit    BigInt     @default(0)
  memo      String?

  @@index([journalId])
  @@index([accountId])
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model AccountingPeriod {
  id       String       @id @default(cuid())
  year     Int
  month    Int
  status   PeriodStatus @default(OPEN)
  closedAt DateTime?
  closedBy String?

  @@unique([year, month])
}

model Receivable {
  id        String    @id @default(cuid())
  /// Piutang dari penjualan (sisa yang belum dibayar pelanggan)
  saleId    String?   @unique
  sale      Sale?     @relation(fields: [saleId], references: [id])
  number    String    @unique
  customer  String
  storeId   String
  date      DateTime
  dueDate   DateTime?
  amount    BigInt
  paid      BigInt    @default(0)
  note      String?
  journalId String?
  createdAt DateTime  @default(now())
}

enum PayableKind {
  USAHA
  PINJAMAN
}

model Payable {
  id            String               @id @default(cuid())
  number        String               @unique
  /// USAHA = utang supplier, PINJAMAN = pinjaman modal
  kind          PayableKind          @default(USAHA)
  supplierId    String?
  supplier      Supplier?            @relation(fields: [supplierId], references: [id])
  vendor        String
  storeId       String
  date          DateTime
  dueDate       DateTime?
  amount        BigInt
  paid          BigInt               @default(0)
  note          String?
  journalId     String?
  createdAt     DateTime             @default(now())
  /// Akun COA hutang (kosong = Hutang Usaha / Hutang Pinjaman Modal sesuai jenis)
  coaAccountId  String?
  coaAccount    CoaAccount?          @relation(fields: [coaAccountId], references: [id])
  /// Jadwal cicilan pinjaman (opsional): jumlah cicilan & total bunga/biaya cicilan → pokok + bunga per cicilan
  installments  Int?
  interestTotal BigInt?
  payments      FinanceTransaction[]
  /// Foto nota / bukti hutang (penyimpanan privat)
  proofPath     String?
  proofMime     String?
}

model FixedAsset {
  id               String   @id @default(cuid())
  name             String
  storeId          String
  acquiredAt       DateTime
  cost             BigInt
  usefulLifeMonths Int
  residual         BigInt   @default(0)
  journalId        String?
  active           Boolean  @default(true)
}

/// Penomoran dokumen atomik (JU-202610-0001, TRX-..., dll.)
model Counter {
  key   String @id
  value Int
}

// ============ PEMBELIAN & GAJI OWNER ============

enum PaymentTerm {
  LUNAS
  BERTAHAP
  TEMPO
}

/// Pembelian bahan baku: menambah stok, membayar sebagian/seluruhnya, sisa menjadi utang usaha
model Purchase {
  id            String            @id @default(cuid())
  number        String            @unique
  supplierId    String?
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  vendor        String
  storeId       String
  date          DateTime
  term          PaymentTerm
  total         BigInt
  paidNow       BigInt            @default(0)
  bankAccountId String?
  payableId     String?
  journalId     String?
  note          String?
  /// Foto bukti transfer (penyimpanan privat)
  proofPath     String?
  proofMime     String?
  createdBy     String
  createdAt     DateTime          @default(now())
  lines         PurchaseLine[]
  receipts      ShiftReceipt[]
  /// Dibatalkan: jurnal dibalik, dokumen tetap tersimpan
  cancelledAt   DateTime?
  cancelReason  String?
  /// Status barang: DITERIMA (langsung masuk gudang) atau pesanan yang masih dikirim (MENUNGGU/SEBAGIAN), DITUTUP = sisa tidak datang
  delivery      PurchaseDelivery  @default(DITERIMA)
  /// COD: dibayar saat barang diterima
  cod           Boolean           @default(false)
  /// Uang muka (paidNow) yang sudah dipakai untuk barang diterima; sisa = paidNow - prepaidUsed
  prepaidUsed   BigInt            @default(0)
  /// Dibayar saat barang datang (COD)
  codPaid       BigInt            @default(0)
  /// Jatuh tempo bila sisa tagihan jadi hutang saat barang diterima
  dueDate       DateTime?
  closedReason  String?
  deliveries    PurchaseReceipt[]
}

enum PurchaseDelivery {
  DITERIMA
  MENUNGGU
  SEBAGIAN
  DITUTUP
}

/// Penerimaan barang pesanan (validasi barang datang): stok masuk + uang muka → persediaan, sisa → hutang/COD
model PurchaseReceipt {
  id             String   @id @default(cuid())
  number         String   @unique
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id])
  date           DateTime
  /// [{lineId, itemId, qty, amount}]
  lines          Json
  value          BigInt
  fromPrepaid    BigInt   @default(0)
  codPaid        BigInt   @default(0)
  toPayable      BigInt   @default(0)
  bankAccountId  String?
  payableId      String?
  journalId      String?
  shiftReceiptId String?  @unique
  photoPath      String?
  photoMime      String?
  note           String?
  receivedBy     String
  createdAt      DateTime @default(now())

  @@index([purchaseId])
}

model PurchaseLine {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  qty         Decimal  @db.Decimal(14, 3)
  unitCost    BigInt
  amount      BigInt
  /// Jumlah yang sudah diterima (pembelian biasa = qty)
  qtyReceived Decimal  @default(0) @db.Decimal(14, 3)
}

/// Dana sisihan harian: kompensasi owner (dicadangkan di ShopeePay) dan dana cicilan pinjaman modal
enum ReserveKind {
  OWNER
  LOAN_SAVING
  LOAN_PAYMENT
}

model ReserveFund {
  id          String         @id @default(cuid())
  name        String
  kind        ReserveKind
  dailyAmount BigInt
  fromBankId  String
  toBankId    String?
  payableId   String?
  storeId     String
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  entries     ReserveEntry[]
}

/// SISIH = penyisihan harian; TARIK = owner mengambil / dana dipakai membayar pinjaman
model ReserveEntry {
  id            String              @id @default(cuid())
  fundId        String
  fund          ReserveFund         @relation(fields: [fundId], references: [id])
  date          DateTime            @db.Date
  type          String
  amount        BigInt
  journalId     String?
  note          String?
  /// Foto bukti transfer sisihan (penyimpanan privat)
  proofPath     String?
  proofMime     String?
  /// Transaksi transfer (menu Transaksi) yang menjadi bukti & jurnal sisihan ini
  transactionId String?
  transaction   FinanceTransaction? @relation(fields: [transactionId], references: [id])
  createdBy     String
  createdAt     DateTime            @default(now())

  @@index([fundId, date])
  @@index([transactionId])
}

/// Tunjangan tetap per karyawan (tidak semua karyawan dapat), dibayar serentak tiap bulan
model EmployeeAllowance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  amount     BigInt
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

/// Notifikasi (pekerjaan tertunda) yang sudah dibaca pengguna; muncul lagi sebagai belum dibaca bila jumlahnya bertambah
model AlertRead {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  count  Int
  readAt DateTime @default(now())

  @@unique([userId, key])
}

/// Kategori item stok & produk jadi (diatur di Pengaturan › Kategori produk); prefix = awalan kode otomatis
model ItemCategory {
  id        String   @id @default(cuid())
  type      ItemType
  name      String
  prefix    String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  @@unique([type, name])
}

// ============ PENJUALAN ============

/// Penjualan offline (pelanggan langsung / WhatsApp). Marketplace tidak dicatat di sini: pendapatannya dari withdraw, HPP-nya dari opname akhir bulan.
model Sale {
  id           String        @id @default(cuid())
  /// Nomor otomatis JUAL-202611-0001
  number       String        @unique
  date         DateTime
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  /// Nama pelanggan saat transaksi (tetap terbaca walau master pelanggan diubah)
  customerName String
  /// Jumlah harga semua baris
  subtotal     BigInt
  /// Diskon per nota (mengurangi pendapatan penjualan)
  discount     BigInt        @default(0)
  /// Ongkir yang ditagih ke pembeli → Pendapatan Ongkir 4-1300
  shipping     BigInt        @default(0)
  /// Tagihan = subtotal − diskon + ongkir
  total        BigInt
  /// Sudah dibayar (pembayaran awal + cicilan)
  paid         BigInt        @default(0)
  dueDate      DateTime?
  /// Jurnal penjualan (pendapatan + pembayaran awal + piutang)
  journalId    String?
  /// Total HPP (keluar stok barang jadi)
  hpp          BigInt        @default(0)
  note         String?
  createdBy    String
  createdAt    DateTime      @default(now())
  /// Dibatalkan: jurnal dibalik, stok kembali, dokumen tetap tersimpan
  cancelledAt  DateTime?
  cancelReason String?
  lines        SaleLine[]
  payments     SalePayment[]
  receivable   Receivable?

  @@index([date])
  @@index([customerId])
}

model SaleLine {
  id       String  @id @default(cuid())
  saleId   String
  sale     Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Barang jadi yang keluar dari gudang
  itemId   String
  item     Item    @relation(fields: [itemId], references: [id])
  qty      Decimal @db.Decimal(14, 3)
  price    BigInt
  amount   BigInt
  /// Harga pokok rata-rata per unit saat dijual
  unitCost BigInt  @default(0)
}

/// Pembayaran penjualan: pembayaran awal (journalId = jurnal penjualan) dan cicilan piutang
model SalePayment {
  id            String      @id @default(cuid())
  saleId        String
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date          DateTime
  amount        BigInt
  bankAccountId String
  bank          BankAccount @relation(fields: [bankAccountId], references: [id])
  /// true = dibayar saat penjualan dicatat (jurnalnya menyatu dengan jurnal penjualan)
  initial       Boolean     @default(false)
  journalId     String?
  note          String?
  proofPath     String?
  proofMime     String?
  createdBy     String
  createdAt     DateTime    @default(now())
  cancelledAt   DateTime?
  cancelReason  String?

  @@index([saleId])
}
